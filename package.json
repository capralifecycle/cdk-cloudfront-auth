{
  "name": "@liflig/cdk-cloudfront-auth",
  "version": "0.0.0-development",
  "description": "CDK Constructs for adding authentication for a CloudFront Distribution",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/capralifecycle/cdk-cloudfront-auth"
  },
  "scripts": {
    "build": "bun run build.ts && tsc",
    "watch": "tsc -w",
    "test": "IS_SNAPSHOT=true bun test",
    "check": "biome ci && bun run typecheck",
    "fix": "biome check --write",
    "prepare": "bun run build && bunx husky",
    "semantic-release": "semantic-release",
    "clean": "rm -rf dist lib",
    "upgrade-deps": "bun update",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "keywords": [
    "cdk",
    "cloudfront",
    "authentication"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "dist/**/*",
    "lib/**/*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "^3.1005.0",
    "@biomejs/biome": "2.5.10",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@liflig/cdk-snapshot": "1.0.0",
    "@types/adm-zip": "^0.5.7",
    "@types/aws-lambda": "8.10.162",
    "@types/bun": "1.4.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.13.3",
    "adm-zip": "^0.6.0",
    "aws-cdk-lib": "2.266.0",
    "axios": "1.19.0",
    "constructs": "10.8.1",
    "cookie": "2.0.1",
    "husky": "9.1.7",
    "jsonwebtoken": "9.0.3",
    "jwks-rsa": "4.1.0",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3"
  },
  "dependencies": {},
  "peerDependencies": {
    "aws-cdk-lib": "^2.0.0"
  },
  "overrides": {
    "minimatch": "10.2.6"
  }
}
